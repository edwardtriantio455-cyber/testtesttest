# MongoDB Atlas connection string (leave blank to use local JSON file)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/exhibition?retryWrites=true&w=majority

# Cloudinary credentials (leave blank to use local disk uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
